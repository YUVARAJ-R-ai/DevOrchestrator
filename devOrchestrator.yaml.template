# DevOrchestrator config — copy to devOrchestrator.yaml and fill in.
# Secrets live in .env; the *_env fields below name the env var to read.

name: yuvaraj          # FILL IN — your name (used in mesh + notifications)
role: dev              # dev | tl
agent: claude          # claude | agy

board:
  type: github         # plane | azure_boards | github
  url: https://github.com/YUVARAJ-R-ai/DevOrchestrator   # FILL IN — your repo
  token_env: GITHUB_TOKEN
  project_number: 10    # FILL IN — GitHub Project (v2) number for Priority/Size fields

git:
  type: github         # gitea | azure_repos | github  (must match board's track)
  url: https://github.com/YUVARAJ-R-ai/DevOrchestrator   # FILL IN — your repo
  token_env: GITHUB_TOKEN
  reviewer: Haise-727   # FILL IN — GitHub *login* to request review from.
                        # `devorchestrator review` lists PRs awaiting this login;
                        # it is not the same thing as `name:` above.

brain:                 # optional — external LLM for PR descriptions
  provider: openrouter
  model: deepseek/deepseek-v4-flash
  token_env: OPENROUTER_API_KEY

notify:                # optional
  type: mattermost     # mattermost | teams
  webhook_env: MATTERMOST_WEBHOOK

mesh:                  # required — Supabase connection
  supabase_url: https://<project>.supabase.co
  supabase_key_env: SUPABASE_SERVICE_KEY
