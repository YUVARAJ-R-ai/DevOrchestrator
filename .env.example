# Copy to .env and fill in. .env is gitignored — never commit real secrets.
GITHUB_TOKEN=
SUPABASE_SERVICE_KEY=
# Brain (PR descriptions). Set the one matching `brain.provider` in your yaml —
# SILICONFLOW_API_KEY for the template's default, OPENROUTER_API_KEY if you
# switch provider. A missing key degrades to the mechanical description.
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
MATTERMOST_WEBHOOK=
